# Copy to supabase/functions/.env for local runs, and set the real values in the
# Supabase dashboard (Edge Functions > Secrets) or with `supabase secrets set --env-file`.
# NEVER commit the real file. SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# are provided automatically to hosted Edge Functions; don't set them yourself there.

# QuickBooks Online (developer.intuit.com > your app > Keys & credentials)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/qbo-callback
QBO_ENVIRONMENT=sandbox            # sandbox | production
QBO_MINOR_VERSION=75
QBO_DEFAULT_ITEM_ID=               # QuickBooks Item used for invoice lines (open decision)
QBO_WEBHOOK_VERIFIER_TOKEN=        # Webhooks page in the Intuit app

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="LicenseLogger <no-reply@mail.yourdomain.com>"

# Shared secret that pg_cron sends in the x-cron-secret header (same value stored in Vault as ll_cron_secret)
CRON_SECRET=

# Links used in emails / CORS
LL_DASHBOARD_URL=https://dashboard.yourdomain.com
LL_APP_LINK=https://yourdomain.com/app
LL_ALLOWED_ORIGINS=https://dashboard.yourdomain.com,http://127.0.0.1:5173
